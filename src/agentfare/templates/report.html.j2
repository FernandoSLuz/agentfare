<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<title>AgentFare weekly report {{ v.week }}</title>
<style>
:root {
  color-scheme: dark;
  --page: #0d0d0d;
  --surface: #1a1a19;
  --edge: rgba(255, 255, 255, 0.10);
  --ink: #ffffff;
  --ink-2: #c3c2b7;
  --ink-3: #a8a69c;
  --track: #2c2c2a;
  --rule: #2c2c2a;
  --spent: #3987e5;
  --routed: #199e70;
  --good: #0ca30c;
  --warn: #fab219;
  --warn-wash: rgba(250, 178, 25, 0.10);
  --tier-light: #86b6ef;
  --tier-medium: #3987e5;
  --tier-heavy: #184f95;
  --glow: rgba(57, 135, 229, 0.16);
}
@media (prefers-color-scheme: light) {
  :root {
    color-scheme: light;
    --page: #f9f9f7;
    --surface: #fcfcfb;
    --edge: rgba(11, 11, 11, 0.10);
    --ink: #0b0b0b;
    --ink-2: #52514e;
    --ink-3: #6a6964;
    --track: #ecebe6;
    --rule: #e1e0d9;
    --spent: #2a78d6;
    --routed: #17a173;
    --good: #006300;
    --warn-wash: rgba(250, 178, 25, 0.16);
    --glow: rgba(42, 120, 214, 0.10);
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  padding: 40px 16px;
  background: var(--page);
  color: var(--ink);
  font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
.card {
  max-width: 1080px;
  margin: 0 auto;
  padding: 56px;
  background: var(--surface);
  background-image: radial-gradient(900px 340px at 12% -8%, var(--glow), transparent 70%);
  border: 1px solid var(--edge);
  border-radius: 28px;
  overflow-wrap: anywhere;
}
h1, h2, p, ul, ol, table { margin: 0; }
ul, ol { padding: 0; list-style: none; }
.num { font-variant-numeric: tabular-nums; }
.muted { color: var(--ink-2); }
.kicker { font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
.kicker.plain { font-size: 15px; letter-spacing: 0; text-transform: none; }

/* header */
.top { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
.brand { display: flex; align-items: center; gap: 12px; }
.brand h1 { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }
.brand span { color: var(--ink-2); font-weight: 500; }
.when { text-align: right; color: var(--ink-2); font-size: 15px; }
.when b { color: var(--ink); font-weight: 600; }

/* hero */
.hero { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 32px 64px; margin-top: 48px; }
/* side takes the free space when both fit on a row; when they wrap, main is alone on its row and grows to fill it */
.hero .main { flex: 1 0 calc(50% - 32px); min-width: min-content; }
.hero .side { flex: 999 1 260px; }
.figure { font-size: clamp(40px, 13.5vw, 104px); font-weight: 700; letter-spacing: -0.035em; line-height: 1; margin-top: 12px; overflow-wrap: normal; }
.figure.long { font-size: clamp(32px, 10vw, 80px); }
.figure.small { font-size: clamp(40px, 7vw, 64px); }
.figure.tiny { font-size: clamp(28px, 5vw, 40px); margin-top: 8px; }
.figure.good { color: var(--good); }
.meta { margin-top: 14px; color: var(--ink-2); font-size: 16px; }
.meta strong { color: var(--ink); font-weight: 600; }
.pill { display: inline-block; margin-top: 10px; padding: 4px 14px; border: 1px solid var(--edge); border-radius: 16px; font-size: 14px; color: var(--ink-2); }
.own { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--rule); }
.own .meta { margin-top: 8px; }
.lead { font-size: 22px; line-height: 1.4; max-width: 34ch; color: var(--ink); }
.compare { flex: 1 1 100%; display: grid; grid-template-columns: 150px minmax(0, 1fr) max-content; gap: 16px 20px; align-items: center; padding-top: 32px; border-top: 1px solid var(--rule); }
.cmp-row { display: contents; }
.cmp-row .name { font-weight: 600; }
.cmp-row .amount { text-align: right; font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
.bar { display: block; width: 100%; overflow: visible; }
.track { fill: var(--track); }
.fill { fill: var(--spent); }
.fill.routed { fill: var(--routed); }
.tail { grid-column: 1 / -1; color: var(--ink-2); font-size: 14px; }

/* warning */
.warn { display: flex; gap: 14px; margin-top: 36px; padding: 16px 20px; background: var(--warn-wash); border: 1px solid var(--edge); border-radius: 16px; }
.warn .badge { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--warn); color: #0b0b0b; font-weight: 800; text-align: center; line-height: 24px; }
.warn p { font-weight: 600; }
.warn ul { margin-top: 6px; font-size: 14px; color: var(--ink-2); }
.warn li + li { margin-top: 4px; }

/* panels */
.panels { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px 64px; margin-top: 56px; }
.panel h2 { font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
.panel .sub { margin-top: 4px; font-size: 14px; color: var(--ink-3); }
.panel .body { margin-top: 20px; }
.bars li + li { margin-top: 18px; }
.bars .line { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 8px; }
.bars .name { font-weight: 500; overflow-wrap: anywhere; }
.bars .val { white-space: nowrap; font-variant-numeric: tabular-nums; font-weight: 600; }
.bars .val i { font-style: normal; font-weight: 400; color: var(--ink-3); margin-left: 8px; }
.days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; align-items: end; }
.day { display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 0; }
.day .v { height: 18px; font-size: 12px; color: var(--ink-2); font-variant-numeric: tabular-nums; white-space: nowrap; }
.day svg { display: block; width: 100%; max-width: 24px; }
.day .d { font-size: 13px; font-weight: 600; }
.day .n { display: flex; flex-direction: column; align-items: center; margin-top: -4px; font-size: 12px; line-height: 1.3; color: var(--ink-3); white-space: nowrap; }
.mix { display: block; width: 100%; height: 16px; overflow: hidden; border-radius: 8px; background: var(--track); }
.cap { margin: 6px 0 20px; font-size: 13px; color: var(--ink-3); }
.mix rect { stroke: var(--surface); stroke-width: 2; }
.t-light { fill: var(--tier-light); }
.t-medium { fill: var(--tier-medium); }
.t-heavy { fill: var(--tier-heavy); }
.tiers li { display: grid; grid-template-columns: 12px 1fr auto auto; grid-template-areas: "sw nm c m"; gap: 12px; align-items: center; }
.tiers li + li { margin-top: 12px; }
.tiers .sw { grid-area: sw; width: 12px; height: 12px; border-radius: 4px; }
.tiers .nm { grid-area: nm; }
.tiers .sw.light { background: var(--tier-light); }
.tiers .sw.medium { background: var(--tier-medium); }
.tiers .sw.heavy { background: var(--tier-heavy); }
.tiers .c { grid-area: c; color: var(--ink-2); font-variant-numeric: tabular-nums; min-width: 84px; text-align: right; }
.tiers .m { grid-area: m; font-weight: 600; font-variant-numeric: tabular-nums; min-width: 72px; text-align: right; }

/* biggest savings */
.wide { grid-column: 1 / -1; }
table { width: 100%; border-collapse: collapse; font-size: 15px; }
th { padding: 0 12px 10px 0; text-align: left; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); border-bottom: 1px solid var(--rule); }
td { padding: 14px 12px 14px 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
th.r, td.r { text-align: right; padding-right: 0; padding-left: 12px; font-variant-numeric: tabular-nums; white-space: nowrap; }
td code { font: 600 14px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
td .who { display: block; max-width: 36ch; margin-top: 2px; font-size: 13px; color: var(--ink-3); }
td .arrow { color: var(--ink-3); padding: 0 4px; }
td.r .sub { display: block; font-size: 13px; color: var(--ink-3); font-weight: 400; }
td.gain { font-weight: 700; color: var(--good); }
td.gain .sub { color: var(--ink-3); }

/* notes and footer */
.notes { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--rule); font-size: 14px; color: var(--ink-2); }
.notes li { position: relative; padding-left: 16px; max-width: 86ch; }
.notes li + li { margin-top: 8px; }
.notes li::before { content: ""; position: absolute; left: 0; top: 0.65em; width: 5px; height: 5px; border-radius: 50%; background: var(--ink-3); }
.foot { margin-top: 24px; font-size: 13px; color: var(--ink-3); }

@media (max-width: 860px) {
  .card { padding: 40px 32px; }
  .panels { grid-template-columns: minmax(0, 1fr); gap: 48px; }
}
@media (max-width: 560px) {
  body { padding: 16px; }
  .card { padding: 28px 20px; border-radius: 20px; }
  .top { align-items: flex-start; }
  .when { text-align: left; }
  .hero { margin-top: 32px; }
  .lead { font-size: 19px; }
  .compare { grid-template-columns: 1fr auto; row-gap: 8px; }
  .cmp-row .bar { grid-column: 1 / -1; }
  .cmp-row:nth-of-type(1) .name, .cmp-row:nth-of-type(1) .amount { grid-row: 1; }
  .cmp-row:nth-of-type(1) .bar { grid-row: 2; }
  .cmp-row:nth-of-type(2) .name, .cmp-row:nth-of-type(2) .amount { grid-row: 3; margin-top: 12px; }
  .cmp-row:nth-of-type(2) .bar { grid-row: 4; }
  .days { gap: 4px; }
  .day .v { font-size: 11px; }
  /* the bar is sized by session count, so the count stays: under the name, the amount to the right of both */
  .tiers li { grid-template-columns: 12px 1fr auto; grid-template-areas: "sw nm m" ". c m"; gap: 0 12px; }
  .tiers .c { min-width: 0; text-align: left; font-size: 13px; color: var(--ink-3); }
  thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  table, tbody, tr, td { display: block; }
  tr { padding: 14px 0; border-bottom: 1px solid var(--rule); }
  td { padding: 2px 0; border: 0; }
  td.r { padding-left: 0; text-align: left; }
  td.r::before, td.gain::before { content: attr(data-label) ": "; color: var(--ink-3); font-weight: 400; }
  td.gain .sub { display: inline; margin-left: 6px; }
}
@media (max-width: 400px) {
  .day .v { font-size: 10px; }
  .day .d { font-size: 12px; }
}
@media print {
  :root {
    color-scheme: light;
    --page: #ffffff; --surface: #ffffff; --edge: #d9d8d0; --ink: #0b0b0b; --ink-2: #3c3b38; --ink-3: #52514e;
    --track: #ecebe6; --rule: #d9d8d0; --spent: #2a78d6; --routed: #17a173; --good: #006300; --glow: transparent;
  }
  body { padding: 0; }
  .card { max-width: none; padding: 0; border: 0; border-radius: 0; background-image: none; }
  .panel, .warn, tr { break-inside: avoid; }
  svg, .sw, .warn .badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  @page { margin: 14mm; }
}
</style>
</head>
<body>
{% macro bar(width, tone="") %}
<svg class="bar" width="100%" height="10" aria-hidden="true" focusable="false"><rect class="track" width="100%" height="10" rx="5"/><rect class="fill {{ tone }}" width="{{ width }}%" height="10" rx="5"/></svg>
{% endmacro %}
{% macro rows(items) %}
<ul class="bars">
{% for r in items %}
<li>
<div class="line"><span class="name">{{ r.label }}</span><span class="val">{{ r.cost }}{% if r.cost != "no verified price" %}<i>{{ r.share }}</i>{% endif %}</span></div>
{{ bar(r.width) }}
</li>
{% endfor %}
</ul>
{% endmacro %}
<main class="card">
<header class="top">
<div class="brand">
<svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="9" fill="var(--spent)"/><path d="M9 11h7a4 4 0 0 1 4 4v2a4 4 0 0 0 4 4" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><circle cx="9" cy="11" r="2.4" fill="#fff"/><circle cx="24" cy="21" r="2.4" fill="#fff"/></svg>
<h1>AgentFare <span>weekly report</span></h1>
</div>
<p class="when"><b>{{ v.week }}</b><br>{{ v.range }}</p>
</header>
{% if v.state == "empty" %}

<section class="hero">
<div>
<p class="lead">{{ v.message }}</p>
{% for hint in v.hints %}
<p class="meta">{{ hint }}</p>
{% endfor %}
</div>
</section>
{% else %}

<section class="hero" aria-label="Summary">
<div class="main">
<p class="kicker">Spent on AI coding agents</p>
{% if v.state == "unpriced" %}
<p class="figure">n/a</p>
<p class="meta">{{ v.counts }}</p>
{% else %}
<p class="figure{{ v.figure }}">{{ v.spend }}</p>
<p class="meta">{{ v.counts }}</p>
{% endif %}
{% if v.change %}
<p class="pill">Spend {{ v.change }}</p>
{% elif v.ongoing %}
<p class="pill">Week in progress</p>
{% endif %}
</div>
<div class="side">
{% if v.state == "savings" %}
<p class="kicker plain">{{ v.first.kicker }}</p>
<p class="figure small {{ v.first.tone }}">{{ v.first.pct }}</p>
<p class="meta">{% if v.first.saved %}<strong>{{ v.first.saved }}</strong> {% endif %}{{ v.first.base }}{% if v.first.moved %}{% if v.first.base %}, {% endif %}{{ v.first.moved }}{% endif %}</p>
<div class="own">
<p class="kicker plain">{{ v.second.kicker }}</p>
<p class="figure tiny {{ v.second.tone }}">{{ v.second.pct }}</p>
<p class="meta">{% if v.second.saved %}<strong>{{ v.second.saved }}</strong> {% endif %}{{ v.second.base }}{% if v.second.moved %}{% if v.second.base %}, {% endif %}{{ v.second.moved }}{% endif %}</p>
</div>
{% else %}
<p class="kicker">Router check</p>
<p class="lead">{{ v.check }}</p>
{% endif %}
</div>
{% if v.state == "savings" %}
<div class="compare" role="group" aria-label="Actual spend against spend with the router">
<div class="cmp-row"><span class="name">You spent</span>{{ bar("100") }}<span class="amount">{{ v.actual }}</span></div>
<div class="cmp-row"><span class="name">With the router</span>{{ bar(v.router_width, "routed") }}<span class="amount">{{ v.router }}</span></div>
{% if v.compared_partly %}
<p class="tail">{{ v.compared_partly }}</p>
{% endif %}
</div>
{% endif %}
</section>
{% if v.warning %}

<section class="warn" role="note" aria-label="Price warning">
<span class="badge" aria-hidden="true">!</span>
<div>
<p>Warning: {{ v.warning.head }}.</p>
<ul>
{% for w in v.warning.lines %}
<li>{% if w.tokens %}<span class="num">{{ w.tokens }} tokens</span>: {% endif %}{{ w.model }}{{ w.rest }}</li>
{% endfor %}
</ul>
</div>
</section>
{% endif %}

<div class="panels">
<section class="panel" aria-labelledby="h-model">
<h2 id="h-model">Spend by model</h2>
<div class="body">
{{ rows(v.models) }}
</div>
</section>
<section class="panel" aria-labelledby="h-agent">
<h2 id="h-agent">By agent</h2>
<div class="body">
{{ rows(v.agents) }}
</div>
</section>
<section class="panel" aria-labelledby="h-day">
<h2 id="h-day">By day</h2>
<div class="body days">
{% for d in v.days %}
<div class="day" title="{{ d.title }}">
<span class="v">{{ d.short }}</span>
<svg height="112" aria-hidden="true" focusable="false"><rect class="track" width="100%" height="112" rx="6"/><rect class="fill" y="{{ d.top }}%" width="100%" height="{{ d.height }}%" rx="6"/></svg>
<span class="d">{{ d.label }}</span>
<span class="n"><span>{{ d.month }}</span><span>{{ d.dom }}</span></span>
</div>
{% endfor %}
</div>
</section>
<section class="panel" aria-labelledby="h-mix">
<h2 id="h-mix">Session mix</h2>
<p class="sub">By size, not difficulty: tokens, tool calls, files, retries, active time.</p>
<div class="body">
<svg class="mix" height="16" aria-hidden="true" focusable="false">
{% for s in v.segments %}
<rect class="t-{{ s.tier }}" x="{{ s.x }}%" width="{{ s.width }}%" height="16"/>
{% endfor %}
</svg>
<p class="cap">Bar: share of sessions</p>
<ul class="tiers">
{% for t in v.tiers %}
<li><span class="sw {{ t.tier }}"></span><span class="nm">{{ t.label }}</span><span class="c">{{ t.sessions }}</span><span class="m">{{ t.cost }}</span></li>
{% endfor %}
</ul>
</div>
</section>
{% if v.state == "savings" %}
<section class="panel wide" aria-labelledby="h-top">
<h2 id="h-top">Biggest savings</h2>
<div class="body">
{% if v.top %}
<table>
<thead><tr><th>Session</th><th>Model</th><th class="r">You spent</th><th class="r">Router</th><th class="r">Saved</th></tr></thead>
<tbody>
{% for s in v.top %}
<tr>
<td data-label="Session"><code>{{ s.id }}</code><span class="who">{{ s.agent }}, {{ s.project }}, {{ s.tier }}</span></td>
<td data-label="Model">{{ s.model }}<span class="arrow">&rarr;</span>{{ s.to }}</td>
<td class="r" data-label="You spent">{{ s.actual }}</td>
<td class="r" data-label="Router">{{ s.router }}</td>
<td class="r gain" data-label="Saved">{{ s.saved }}<span class="sub">{{ s.ratio }} cheaper</span></td>
</tr>
{% endfor %}
</tbody>
</table>
{% else %}
<p class="muted">No session with a prompt had an advised switch: the saving comes from sub-agent and background sessions, which are not listed.</p>
{% endif %}
</div>
</section>
{% endif %}
</div>

<ul class="notes">
{% for note in v.notes %}
<li>{{ note }}</li>
{% endfor %}
</ul>
{% endif %}

<p class="foot">Generated {{ v.generated }} by agentfare {{ v.version }}. Local-first: no account, no cloud, no prompts stored.</p>
</main>
</body>
</html>
