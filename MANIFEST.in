# What goes into the source distribution besides the package itself (setuptools adds src/ and pyproject.toml on its own).
# The sdist must be enough to run the whole test suite, offline, after `pip install -e .`: the tests read the README, the docs,
# the demo script and the fixtures, and some of them read the CI workflow and the constraints file. Every file at the root of
# the tree is named here (tests/test_install_paths.py::TestSdist fails for one that is missing).
include README.md README.pt-BR.md LICENSE CHANGELOG.md SECURITY.md CODE_OF_CONDUCT.md CONTRIBUTING.md demo.tape constraints-min.txt pricing.yaml
graft docs
graft scripts
graft tests
graft .github
include src/agentfare/data/pricing.yaml
recursive-include src/agentfare/templates *
global-exclude __pycache__ *.py[cod] *.egg-info .DS_Store
prune tests/.pytest_cache
